  void _showEditStock(InventoryDevice device) {
    final model = TextEditingController(text: device.model);
    final imei = TextEditingController(text: device.imei);
    String store = device.store;
    DeviceStatus status = device.status;
    String? error;
    showDialog(
      context: context,
      builder: (dialogContext) => StatefulBuilder(
        builder: (context, setDialogState) => AlertDialog(
          title: const Text('Edit device'),
          content: SizedBox(
            width: 420,
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                TextField(
                  controller: model,
                  decoration: const InputDecoration(labelText: 'Model'),
                ),
                TextField(
                  controller: imei,
                  keyboardType: TextInputType.number,
                  decoration: const InputDecoration(labelText: 'IMEI'),
                ),
                DropdownButtonFormField<String>(
                  initialValue: store,
                  decoration: const InputDecoration(labelText: 'Store'),
                  items: stores
                      .skip(1)
                      .map(
                        (s) => DropdownMenuItem(
                          value: s.name,
                          child: Text(s.name),
                        ),
                      )
                      .toList(),
                  onChanged: (v) => setDialogState(() => store = v!),
                ),
                DropdownButtonFormField<DeviceStatus>(
                  initialValue: status,
                  decoration: const InputDecoration(labelText: 'Status'),
                  items: DeviceStatus.values
                      .map(
                        (s) => DropdownMenuItem(value: s, child: Text(s.label)),
                      )
                      .toList(),
                  onChanged: (v) => setDialogState(() => status = v!),
                ),
                if (error != null)
                  Padding(
                    padding: const EdgeInsets.only(top: 12),
                    child: Text(
                      error!,
                      style: const TextStyle(color: Colors.red),
                    ),
                  ),
              ],
            ),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(dialogContext),
              child: const Text('Cancel'),
            ),
            FilledButton(
              onPressed: () {
                final newModel = model.text.trim();
                final newImei = imei.text.trim();
                if (newModel.isEmpty) {
                  setDialogState(() => error = 'Enter a device model.');
                  return;
                }
                if (!RegExp(r'^\d{15}$').hasMatch(newImei)) {
                  setDialogState(
                    () => error = 'IMEI must contain exactly 15 digits.',
                  );
                  return;
                }
                if (inventory.any((d) => d != device && d.imei == newImei)) {
                  setDialogState(() => error = 'This IMEI already exists.');
                  return;
                }
                setState(() {
                  device.model = newModel;
                  device.imei = newImei;
                  device.store = store;
                  device.status = status;
                });
                Navigator.pop(dialogContext);
              },
              child: const Text('Save'),
            ),
          ],
        ),
      ),
    );
  }

