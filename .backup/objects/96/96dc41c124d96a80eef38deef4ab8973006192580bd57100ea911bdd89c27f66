  bool _hasPendingTransfer(InventoryDevice device) => transfers.any(
    (transfer) => transfer.devices.contains(device) && transfer.isPending,
  );

  Future<void> _updateTransferStatus(
    StockTransfer transfer,
    String status,
  ) async {
    if (!transfer.isPending || status == 'Pending') return;

    final action = status == 'Completed' ? 'complete' : 'cancel';
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        title: Text(
          '${action[0].toUpperCase()}${action.substring(1)} transfer?',
        ),
        content: Text(
          status == 'Completed'
              ? 'This will move ${transfer.itemCount} device${transfer.itemCount == 1 ? '' : 's'} to ${transfer.toStore}.'
              : 'The batch will be cancelled and the devices will remain at ${transfer.fromStore}.',
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext, false),
            child: const Text('Keep pending'),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(dialogContext, true),
            child: Text(action[0].toUpperCase() + action.substring(1)),
          ),
        ],
      ),
    );
    if (confirmed != true || !mounted) return;

    setState(() {
      if (status == 'Completed') {
        for (final device in transfer.devices) {
          device.store = transfer.toStore;
        }
      }
      transfer.status = status;
    });
  }

  void _showAddTransfer() {
    final available = inventory
        .where(
          (d) => d.status == DeviceStatus.inStock && !_hasPendingTransfer(d),
        )
        .toList();
    if (available.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('No in-stock devices are available for transfer.'),
        ),
      );
      return;
    }
    final selectedDevices = <InventoryDevice>[available.first];
    var destination = stores
        .firstWhere(
          (s) => s.name != selectedDevices.first.store,
          orElse: () => stores.first,
        )
        .name;
    showDialog(
      context: context,
      builder: (dialogContext) => StatefulBuilder(
        builder: (context, setDialogState) => AlertDialog(
          title: const Text('New transfer'),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text('Select devices'),
                  const SizedBox(height: 8),
                  ...available.map(
                    (d) => CheckboxListTile(
                      dense: true,
                      contentPadding: EdgeInsets.zero,
                      value: selectedDevices.contains(d),
                      title: Text('${d.model} · ${d.imei}'),
                      onChanged: (checked) => setDialogState(() {
                        if (checked == true) {
                          selectedDevices.add(d);
                        } else if (selectedDevices.length > 1) {
                          selectedDevices.remove(d);
                        }
                      }),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 12),
              DropdownButtonFormField<String>(
                initialValue: destination,
                decoration: const InputDecoration(
                  labelText: 'Destination store',
                ),
                items: stores
                    .where((s) => s.name != selectedDevices.first.store)
                    .map(
                      (s) =>
                          DropdownMenuItem(value: s.name, child: Text(s.name)),
                    )
                    .toList(),
                onChanged: (value) =>
                    setDialogState(() => destination = value!),
              ),
            ],
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(dialogContext),
              child: const Text('Cancel'),
            ),
            FilledButton(
              onPressed: () {
                setState(
                  () => transfers.add(
                    StockTransfer(
                      devices: List.of(selectedDevices),
                      fromStore: selectedDevices.first.store,
                      toStore: destination,
                    ),
                  ),
                );
                Navigator.pop(dialogContext);
              },
              child: const Text('Create'),
            ),
          ],
        ),
      ),
    );
  }

