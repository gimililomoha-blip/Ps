import 'package:flutter/material.dart';

enum DeviceStatus { inStock, reserved, sold }

extension DeviceStatusLabel on DeviceStatus {
  String get label => switch (this) {
    DeviceStatus.inStock => 'In stock',
    DeviceStatus.reserved => 'Reserved',
    DeviceStatus.sold => 'Sold',
  };
}

class Store {
  Store(this.name);
  final String name;
}

class InventoryDevice {
  InventoryDevice({required this.model, required this.imei, required this.store, this.status = DeviceStatus.inStock});
  String model;
  String imei;
  String store;
  DeviceStatus status;
}

class AppUser {
  AppUser({required this.name, required this.email, required this.role, required this.store, this.active = true});
  final String name;
  final String email;
  final String role;
  final String store;
  bool active;
}

